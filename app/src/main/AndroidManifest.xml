<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         PERMISSIONS — each justified per Google Play policy (BRD §5.1 & §8)
         ============================================================ -->

    <!-- File access — Play Store exemption form required before GA launch.
         Submitted via Play Console: PurgeIt is a file management application
         requiring broad file access for duplicate detection and junk cleanup. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Usage stats — cannot be granted via runtime dialog; requires manual
         Settings toggle. Onboarding screen provides animated deep-link guide. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Media access for API 33+ (READ_EXTERNAL_STORAGE auto-handled for API <33) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Legacy media access for API 26–32 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notifications — requested ONLY after onboarding, never on first launch -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service — paired with persistent notification as required.
         Type declared explicitly to avoid ANR on Android 14+ (API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Boot receiver — used only to restart legitimate scheduled scans (Premium).
         NOT used for ads or re-engagement. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Exact alarms — default is inexact WorkManager. Exact alarm only for
         Premium with Play Console justification. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Network access for Firebase (analytics/crash only — no user file data) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- REQUEST_INSTALL_PACKAGES is intentionally ABSENT.
         Uninstall uses ACTION_UNINSTALL_PACKAGE OS intent only. -->

    <application
        android:name=".PurgeItApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PurgeIt"
        tools:targetApi="31">

        <!-- Main entry point -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PurgeIt.SplashScreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground scan service — type required on API 34+ -->
        <service
            android:name=".data.service.StorageScanService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.FOREGROUND_SERVICE" />

        <!-- Boot receiver — restarts scheduled scans only -->
        <receiver
            android:name=".data.receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for file preview intents (FR-F10) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- WorkManager initializer — Hilt integration -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
